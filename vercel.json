{
  "version": 2,
  "builds": [
    {
      "src": "backend/server-redis.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["../data/**"]
      }
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server-redis.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/dist/index.html"
    }
  ]
}
